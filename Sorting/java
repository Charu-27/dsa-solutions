// Problem: largest-number-at-least-twice-of-others (LeetCode #747)
// Link: https://leetcode.com/problems/largest-number-at-least-twice-of-others/
// Approach: Find the largest and second largest elements, then check if the largest is at least twice the second largest.
// Time: O(N) | Space: O(1)

import java.util.*;

class Solution {
    public int dominantIndex(int[] nums) {
        int n = nums.length;
        Map<Integer, Integer> mp = new HashMap<>();

        for (int i = 0; i < n; i++) {
            mp.put(nums[i], i);
        }

        Arrays.sort(nums);

        if (nums[n - 1] >= nums[n - 2] * 2) {
            return mp.get(nums[n - 1]);
        }

        return -1;
    }
}
