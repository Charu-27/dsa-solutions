// Problem: sum-game (LeetCode #1927)
// Link: https://leetcode.com/problems/sum-game/
// Approach: Count fixed-digit sums and '?' counts in each half.
//           Odd total '?' count → Alice always wins (true).
//           Even count → compare sum difference to 9*(qDiff/2) to check if Bob can force a draw.
// Time: O(N) | Space: O(1)



class Solution {
public:
    bool sumGame(string num) {
        int firstSum = 0, secondSum = 0, cnt1 = 0, cnt2 = 0;
        int n = num.size();
        
        for (int i = 0; i < n/2; i++) {
            if (num[i] == '?') cnt1++;
            else firstSum += (num[i] - '0');
        }
        for (int i = n/2; i < n; i++) {
            if (num[i] == '?') cnt2++;
            else secondSum += (num[i] - '0');
        }
        
        int totalQ = cnt1 + cnt2;
        
        if (totalQ % 2 == 1) return true;

        int diff = firstSum - secondSum;
        int qDiff = cnt2 - cnt1;
        
        return diff != (qDiff * 9) / 2;
    }
};
