/*
 * Problem: Maximum Subarray With Equal Products
 * LeetCode Problem Code: 3411
 * Difficulty: Easy
 *
 * Problem Statement:
 * An array of positive integers arr is called "product equivalent" if
 *     prod(arr) == lcm(arr) * gcd(arr)
 * where prod(arr) is the product of all elements, gcd(arr) is the greatest
 * common divisor of all elements, and lcm(arr) is the least common multiple
 * of all elements.
 * Given an array nums of positive integers, return the length of the
 * longest product equivalent subarray of nums.
 *
 * Constraints:
 *   2 <= nums.length <= 100
 *   1 <= nums[i] <= 10
 *
 * Approach: Brute force with early termination
 *   - Fix a starting index i and extend the subarray one element at a time
 *     with index j.
 *   - Maintain the running product, gcd and lcm of nums[i..j].
 *   - If prod == gcd * lcm, update the answer with the length j - i + 1.
 *   - Otherwise break. Adding more elements can only make prod grow faster
 *     than gcd * lcm, so the condition can never hold again for this i.
 *     (This also keeps the product small, so there is no overflow.)
 *
 * Time Complexity:  O(n^2 * log(M)), where n = nums.size() and M = max(nums[i])
 *                   (n^2 subarray extensions, each doing a gcd/lcm computation)
 * Space Complexity: O(1)
 */
class Solution {
public:
    int maxLength(vector<int>& nums) {
        int res = 0;
        for (int i = 0; i < nums.size(); i++) {
            long prodVal = nums[i];
            long gcdVal = nums[i];
            long lcmVal = nums[i];
            for (int j = i + 1; j < nums.size(); j++) {
                prodVal = prodVal * nums[j];
                gcdVal = gcd(gcdVal, nums[j]);
                lcmVal = lcm(lcmVal, nums[j]);

                if (prodVal != gcdVal * lcmVal) {
                    break;
                }

                res = max(res, j - i + 1);
            }
        }
        return res;
    }
};
